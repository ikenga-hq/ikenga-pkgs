{
	"name": "ikenga-pkgs",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"test": "pnpm -r test --if-present",
		"test:scripts": "node --test \"scripts/*.test.mjs\"",
		"validate:manifests": "node scripts/validate-manifests.mjs",
		"sign:manifests": "node scripts/sign-manifests.mjs",
		"sign:manifests:check": "node scripts/sign-manifests.mjs --check",
		"lift:requires": "node scripts/lift-requires.mjs",
		"lift:requires:check": "node scripts/lift-requires.mjs --check",
		"changeset": "changeset",
		"sync:versions": "node scripts/sync-manifest-versions.mjs",
		"sync:versions:check": "node scripts/sync-manifest-versions.mjs --check",
		"check:registry-stale": "node scripts/check-registry-stale.mjs",
		"scan:nav-only": "node scripts/scan-nav-only.mjs",
		"version-packages": "changeset version && node scripts/sync-manifest-versions.mjs",
		"release": "changeset publish"
	},
	"devDependencies": {
		"@changesets/changelog-github": "^0.5.0",
		"@changesets/cli": "^2.27.10",
		"@ikenga/contract": "^0.19.0"
	},
	"packageManager": "pnpm@9.12.3"
}
