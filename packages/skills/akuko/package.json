{
  "name": "@ikenga/skill-akuko",
  "version": "0.2.0",
  "description": "akuko: an agent skill that takes a short story, treatment or film script to a short film, one reviewed stage at a time (screenplay, breakdown, sketch board, bibles, key frames, motion, lip-sync, sound, DaVinci Resolve handoff). Holds the skill, the akuko.json project format (Zod + JSON Schema) and converters.",
  "keywords": [
    "claude",
    "claude-code",
    "agent-skills",
    "skills",
    "ikenga",
    "akuko",
    "film",
    "storyboard"
  ],
  "homepage": "https://ikenga.dev",
  "bugs": {
    "url": "https://github.com/ikenga-hq/ikenga-pkgs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikenga-hq/ikenga-pkgs.git",
    "directory": "packages/skills/akuko"
  },
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.6"
  },
  "files": [
    "skills",
    "README.md"
  ],
  "scripts": {
    "build": "node --experimental-strip-types --disable-warning=ExperimentalWarning skills/akuko/schema/export-json-schema.ts",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning \"skills/akuko/**/*.test.ts\"",
    "typecheck": "tsc -p skills/akuko/tsconfig.json",
    "convert:fixture": "node --experimental-strip-types --disable-warning=ExperimentalWarning skills/akuko/fixtures/convert-fixture.ts",
    "build:mirror": "node ./scripts/build-mirror.mjs",
    "build:claudeai": "node ./scripts/build-mirror.mjs --claudeai"
  },
  "dependencies": {
    "@ikenga/studio-schema": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "29.1.1",
    "typescript": "^5.4.0",
    "zod-to-json-schema": "^3.25.2"
  }
}
