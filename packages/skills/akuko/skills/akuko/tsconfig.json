{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["schema/**/*.ts", "fixtures/**/*.ts", "actions/**/*.ts", "hosts/**/*.ts", "providers/**/*.ts", "spend/**/*.ts", "breakdown/**/*.ts", "decisions/**/*.ts", "views/**/*.ts", "scripts/**/*.ts", "setup/**/*.ts", "board/**/*.ts", "bible/**/*.ts", "evals/**/*.ts", "keyframes/**/*.ts", "motion/**/*.ts", "sound/**/*.ts", "audit/**/*.ts", "engines/**/*.ts", "blocks/**/*.ts"]
}
