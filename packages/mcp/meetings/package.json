{
  "name": "@ikenga/mcp-meetings",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikenga-hq/ikenga-pkgs.git",
    "directory": "packages/mcp/meetings"
  },
  "mcpName": "dev.ikenga/mcp-meetings",
  "description": "Model Context Protocol (MCP) server for querying meeting transcripts, search, summaries, and recording controls.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "manifest.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "node --test --import=tsx src/tools/search.test.ts src/tools/recorder.test.ts src/integration.test.ts src/index.test.ts src/sqlite.test.ts"
  },
  "dependencies": {
    "@ikenga/meetings-contract": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.23.0",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  }
}
