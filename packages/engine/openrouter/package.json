{
  "name": "@ikenga/pkg-engine-openrouter",
  "version": "0.1.1",
  "description": "OpenRouter unified engine adapter for Ikenga (Plan 24, WP-20).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikenga-hq/ikenga-pkgs.git",
    "directory": "packages/engine/openrouter"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
