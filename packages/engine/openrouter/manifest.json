{
  "id": "com.ikenga.engine-openrouter",
  "name": "OpenRouter Engine",
  "version": "0.1.1",
  "ikenga_api": "1",
  "kind": "engine",

  "author": {
    "name": "Royalti",
    "key": "royalti"
  },

  "ui": {},

  "permissions": {
    "net": ["https://openrouter.ai/api/**"],
    "fs.read": ["$pkg_data/sessions/**"],
    "fs.write": ["$pkg_data/sessions/**"],
    "vault.keys": ["OPENROUTER_API_KEY"]
  },

  "settings": {
    "schema": [
      {
        "key": "model",
        "type": "string",
        "label": "Default model",
        "default": "openrouter/auto",
        "description": "OpenRouter model identifier (e.g. openrouter/auto, anthropic/claude-3.7-sonnet, deepseek/deepseek-r1, meta-llama/llama-3.3-70b-instruct)."
      },
      {
        "key": "base_url",
        "type": "string",
        "label": "API Base URL",
        "default": "https://openrouter.ai/api/v1"
      }
    ]
  },

  "engine": {
    "agentId": "openrouter",
    "display": "OpenRouter Unified LLM",
    "capabilities": {
      "streaming": true,
      "toolUse": true,
      "thinking": true,
      "artifacts": false,
      "fileAttachments": false,
      "imageInput": false,
      "slashCommands": false,
      "modelSwitching": true,
      "promptCaching": false,
      "agenticTools": false,
      "mcp": false,
      "sessionResume": true
    },
    "onboarding": {
      "requiredVaultKeys": ["OPENROUTER_API_KEY"],
      "requiredEnvVars": [],
      "authCommand": "openrouter login",
      "docsUrl": "https://openrouter.ai/docs"
    }
  }
}
