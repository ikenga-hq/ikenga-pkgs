{
  "name": "@ikenga/pkg-engine-codex",
  "version": "0.2.2",
  "description": "Codex CLI engine adapter for Ikenga. Runs agent sessions on the OpenAI `codex` CLI and, at install time, writes pkg-shipped MCP servers, subagents and skills into Codex's own configuration.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikenga-hq/ikenga-pkgs.git",
    "directory": "packages/engine/codex"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "manifest.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import=tsx 'src/**/*.test.ts'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ikenga/contract": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0"
  }
}
