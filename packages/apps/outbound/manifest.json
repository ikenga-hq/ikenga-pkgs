{
  "id": "com.ikenga.outbound",
  "name": "Outbound",
  "version": "0.3.1",
  "ikenga_api": "1",
  "kind": "embedded",
  "author": {
    "name": "Royalti",
    "key": "royalti"
  },
  "ui": {
    "views": [
      {
        "id": "outbound.index",
        "title": "Outbox",
        "icon": "send",
        "route": "/",
        "pin_on_install": true
      },
      {
        "id": "outbound.approvals",
        "title": "Approvals",
        "icon": "check-circle",
        "route": "/approvals",
        "pin_on_install": false
      }
    ],
    "routes": [
      {
        "path": "/",
        "kind": "iframe",
        "source": "dist/index.html"
      },
      {
        "path": "/email",
        "kind": "iframe",
        "source": "dist/index.html"
      },
      {
        "path": "/newsletter",
        "kind": "iframe",
        "source": "dist/index.html"
      },
      {
        "path": "/social",
        "kind": "iframe",
        "source": "dist/index.html"
      },
      {
        "path": "/sequences",
        "kind": "iframe",
        "source": "dist/index.html"
      },
      {
        "path": "/approvals",
        "kind": "iframe",
        "source": "dist/index.html"
      }
    ],
    "csp": {
      "script-src": [
        "'self'",
        "'unsafe-inline'",
        "https://esm.sh"
      ],
      "style-src": [
        "'self'",
        "'unsafe-inline'",
        "https://esm.sh"
      ],
      "font-src": [
        "'self'",
        "https://esm.sh",
        "data:"
      ],
      "connect-src": [
        "'self'",
        "https://esm.sh"
      ]
    }
  },
  "capabilities": {
    "sqlite": {
      "db": "ikenga.local"
    },
    "paActions": true,
    "http": {
      "auth_secret": "twenty"
    },
    "secrets": {
      "declarations": [
        {
          "name": "twenty",
          "vault_key": "TWENTY_API_KEY"
        }
      ]
    }
  },
  "permissions": {
    "shell.execute": [],
    "fs.read": [],
    "fs.write": [],
    "net": [
      "https://esm.sh",
      "https://twenty.royalti.io/rest/"
    ],
    "sqlite.tables": [
      "pa_action_drafts",
      "receivables",
      "newsletter_sends"
    ],
    "vault.keys": [
      "TWENTY_API_KEY"
    ],
    "engine": [
      "invoke"
    ]
  },
  "requires": [
    {
      "kind": "skill",
      "name": "skill-outbound"
    }
  ]
}
