{
  "id": "com.ikenga.agent-ops",
  "name": "Agent Ops",
  "version": "0.2.2",
  "ikenga_api": "1",
  "kind": "embedded",
  "author": {
    "name": "Royalti",
    "key": "royalti"
  },
  "ui": {
    "views": [
      {
        "id": "agentops.index",
        "title": "Agent Ops",
        "icon": "activity",
        "route": "/",
        "pin_on_install": true
      }
    ],
    "routes": [
      {
        "path": "/",
        "kind": "iframe",
        "source": "dist/index.html"
      },
      {
        "path": "/schedule",
        "kind": "iframe",
        "source": "dist/index.html"
      },
      {
        "path": "/runs",
        "kind": "iframe",
        "source": "dist/index.html"
      },
      {
        "path": "/failures",
        "kind": "iframe",
        "source": "dist/index.html"
      },
      {
        "path": "/live",
        "kind": "iframe",
        "source": "dist/index.html"
      }
    ],
    "csp": {
      "script-src": [
        "'self'",
        "'unsafe-inline'",
        "https://esm.sh"
      ],
      "style-src": [
        "'self'",
        "'unsafe-inline'",
        "https://esm.sh"
      ],
      "font-src": [
        "'self'",
        "https://esm.sh",
        "data:"
      ],
      "connect-src": [
        "'self'",
        "https://esm.sh"
      ]
    }
  },
  "capabilities": {
    "sqlite": {
      "db": "ikenga.local"
    },
    "agentOps": {}
  },
  "permissions": {
    "shell.execute": [],
    "fs.read": [],
    "fs.write": [],
    "net": [
      "https://esm.sh"
    ],
    "sqlite.tables": [
      "cron_job_runs",
      "agent_runs"
    ],
    "vault.keys": []
  }
}
