{
  "id": "com.ikenga.content",
  "name": "Content",
  "version": "0.4.1",
  "ikenga_api": "1",
  "kind": "embedded",
  "author": {
    "name": "Royalti",
    "key": "royalti"
  },
  "ui": {
    "views": [
      {
        "id": "content.index",
        "title": "Content",
        "icon": "file-text",
        "route": "/",
        "pin_on_install": true
      }
    ],
    "routes": [
      {
        "path": "/",
        "kind": "iframe",
        "source": "dist/index.html"
      }
    ],
    "csp": {
      "script-src": [
        "'self'",
        "'unsafe-inline'",
        "https://esm.sh"
      ],
      "style-src": [
        "'self'",
        "'unsafe-inline'",
        "https://esm.sh"
      ],
      "font-src": [
        "'self'",
        "https://esm.sh",
        "data:"
      ],
      "connect-src": [
        "'self'",
        "https://esm.sh"
      ]
    }
  },
  "capabilities": {
    "sqlite": {
      "db": "ikenga.local"
    }
  },
  "permissions": {
    "shell.execute": [],
    "fs.read": [],
    "fs.write": [],
    "net": [
      "https://esm.sh"
    ],
    "sqlite.tables": [
      "content_pieces",
      "content_published",
      "content_stage_transitions",
      "content_calendar",
      "social_queue",
      "calendar_events"
    ],
    "vault.keys": [],
    "engine": [
      "invoke"
    ]
  },
  "requires": [
    {
      "kind": "skill",
      "name": "skill-content"
    }
  ]
}
