{
  "id": "com.ikenga.sentry",
  "name": "Sentry",
  "version": "0.2.2",
  "ikenga_api": "1",
  "kind": "embedded",
  "author": {
    "name": "Royalti",
    "key": "royalti"
  },
  "ui": {
    "session": {
      "persistence": "keep"
    },
    "views": [
      {
        "id": "sentry.index",
        "title": "Sentry",
        "icon": "activity",
        "route": "/",
        "pin_on_install": true
      }
    ],
    "routes": [
      {
        "path": "/",
        "kind": "webview",
        "source": "https://sentry.io/",
        "partition": "persist:sentry"
      }
    ]
  },
  "capabilities": {
    "webview": {
      "child_webviews": true,
      "partitions": [
        "persist:sentry"
      ],
      "allowed_origins": [
        "https://sentry.io",
        "https://*.sentry.io"
      ],
      "engines": [
        "chrome"
      ]
    }
  },
  "permissions": {
    "net": [
      "https://*.sentry.io"
    ]
  }
}
