{
  "id": "com.ikenga.tasks",
  "name": "Tasks",
  "version": "0.8.3",
  "ikenga_api": "1",
  "kind": "embedded",
  "author": {
    "name": "Royalti",
    "key": "royalti"
  },
  "ui": {
    "views": [
      {
        "id": "tasks.index",
        "title": "Tasks",
        "icon": "check-square",
        "route": "/",
        "pin_on_install": true
      }
    ],
    "routes": [
      {
        "path": "/",
        "kind": "iframe",
        "source": "dist/index.html"
      }
    ],
    "csp": {
      "script-src": [
        "'self'",
        "'unsafe-inline'",
        "https://esm.sh"
      ],
      "style-src": [
        "'self'",
        "'unsafe-inline'",
        "https://esm.sh"
      ],
      "font-src": [
        "'self'",
        "https://esm.sh",
        "data:"
      ],
      "connect-src": [
        "'self'",
        "https://esm.sh"
      ]
    }
  },
  "capabilities": {
    "sqlite": {
      "db": "ikenga.local"
    }
  },
  "permissions": {
    "shell.execute": [],
    "fs.read": [],
    "fs.write": [],
    "net": [
      "https://esm.sh"
    ],
    "sqlite.tables": [
      "tasks",
      "task_events",
      "task_signals"
    ],
    "vault.keys": [],
    "engine": [
      "invoke"
    ]
  },
  "requires": [
    {
      "kind": "skill",
      "name": "skill-tasks"
    }
  ]
}
