{
  "id": "com.ikenga.research",
  "name": "Research",
  "version": "0.3.1",
  "ikenga_api": "1",
  "kind": "embedded",
  "author": {
    "name": "Royalti",
    "key": "royalti"
  },
  "ui": {
    "views": [
      {
        "id": "research.index",
        "title": "Research",
        "icon": "search",
        "route": "/",
        "pin_on_install": true
      }
    ],
    "routes": [
      {
        "path": "/",
        "kind": "iframe",
        "source": "dist/index.html"
      }
    ],
    "csp": {
      "script-src": [
        "'self'",
        "'unsafe-inline'",
        "https://esm.sh"
      ],
      "style-src": [
        "'self'",
        "'unsafe-inline'",
        "https://esm.sh"
      ],
      "font-src": [
        "'self'",
        "https://esm.sh",
        "data:"
      ],
      "connect-src": [
        "'self'",
        "https://esm.sh"
      ]
    }
  },
  "capabilities": {
    "sqlite": {
      "db": "ikenga.local"
    }
  },
  "permissions": {
    "shell.execute": [],
    "fs.read": [],
    "fs.write": [],
    "net": [
      "https://esm.sh"
    ],
    "sqlite.tables": [
      "research_notes",
      "research_sources",
      "sales_deals"
    ],
    "vault.keys": [],
    "engine": [
      "invoke"
    ]
  },
  "requires": [
    {
      "kind": "skill",
      "name": "skill-research"
    }
  ]
}
