{
  "name": "@ikenga/pkg-studio",
  "version": "0.7.1",
  "type": "module",
  "description": "com.ikenga.studio app pkg — project sidecar (storyboard/render queue with fal.ai + Excalidraw renderer adapters), FFmpeg-backed exporter, prompt-package Track-B handoff, a 40-tool MCP server, and the full M-A production-desk iframe UI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.web.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "build:sidecar": "bash sidecars/project/build.sh",
    "dev:sidecar": "bash sidecars/project/build.sh --watch",
    "build:mcp": "bash mcp/build.sh",
    "dev:mcp": "bash mcp/build.sh --watch",
    "prepublishOnly": "npm run build:mcp && npm run build:sidecar"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fal-ai/client": "^1.6.2",
    "@ikenga/contract": "^0.13.0",
    "@ikenga/studio-schema": "workspace:*",
    "@ikenga/tokens": "^0.3.0",
    "@ikenga/ui-lib": "workspace:*",
    "@modelcontextprotocol/ext-apps": "^1.7.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@supabase/supabase-js": "^2.45.0",
    "chokidar": "^3.6.0",
    "excalidraw-animate": "^0.7.2",
    "puppeteer": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.27.7",
    "tailwindcss": "4",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  },
  "files": [
    "manifest.json",
    "dist",
    "mcp/dist",
    "sidecars/project/dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ikenga-hq/ikenga-pkgs.git",
    "directory": "packages/apps/studio"
  }
}
