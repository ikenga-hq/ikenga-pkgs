{
  "id": "com.ikenga.sales",
  "name": "Sales",
  "version": "0.4.0",
  "ikenga_api": "1",
  "kind": "embedded",
  "author": { "name": "Royalti", "key": "royalti" },

  "ui": {
    "views": [
      {
        "id": "sales.index",
        "title": "Sales",
        "icon": "trending-up",
        "route": "/",
        "pin_on_install": true
      }
    ],
    "routes": [
      {
        "path": "/",
        "kind": "iframe",
        "source": "dist/index.html"
      }
    ],
    "csp": {
      "script-src": ["'self'", "'unsafe-inline'", "https://esm.sh"],
      "style-src": ["'self'", "'unsafe-inline'", "https://esm.sh"],
      "font-src": ["'self'", "https://esm.sh", "data:"],
      "connect-src": ["'self'", "https://esm.sh"]
    }
  },

  "capabilities": {
    "sqlite": { "db": "ikenga.local" }
  },

  "permissions": {
    "shell.execute": [],
    "fs.read": [],
    "fs.write": [],
    "net": ["https://esm.sh"],
    "sqlite.tables": [
      "sales_deals",
      "sales_activities",
      "sales_forecasts",
      "sales_lead_scores",
      "contacts"
    ],
    "vault.keys": [],
    "engine": ["invoke"]
  },

  "requires": [
    {
      "kind": "skill",
      "name": "skill-sales"
    }
  ]
}
