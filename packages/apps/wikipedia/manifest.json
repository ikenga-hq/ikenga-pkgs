{
  "id": "com.ikenga.wikipedia",
  "name": "Wikipedia",
  "version": "0.1.1",
  "ikenga_api": "4",
  "kind": "embedded",
  "author": { "name": "Royalti", "key": "royalti" },
  "ui": {
    "session": { "persistence": "clear-on-exit" },
    "views": [
      {
        "id": "wikipedia.index",
        "title": "Wikipedia",
        "icon": "book-open",
        "route": "/",
        "pin_on_install": true
      }
    ],
    "routes": [
      {
        "path": "/",
        "kind": "webview",
        "source": "https://en.wikipedia.org/",
        "partition": "persist:wikipedia"
      }
    ]
  },
  "capabilities": {
    "webview": {
      "child_webviews": true,
      "partitions": ["persist:wikipedia"],
      "allowed_origins": [
        "https://en.wikipedia.org",
        "https://*.wikipedia.org",
        "https://*.wikimedia.org"
      ],
      "engines": ["webkit"]
    }
  },
  "permissions": {
    "net": ["https://*.wikipedia.org", "https://*.wikimedia.org"]
  }
}
