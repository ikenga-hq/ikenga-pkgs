{
  "id": "com.ikenga.finance",
  "name": "Finance",
  "version": "0.3.1",
  "ikenga_api": "1",
  "kind": "embedded",
  "author": {
    "name": "Royalti",
    "key": "royalti"
  },
  "ui": {
    "views": [
      {
        "id": "finance.index",
        "title": "Finance",
        "icon": "bar-chart-2",
        "route": "/",
        "pin_on_install": true
      }
    ],
    "routes": [
      {
        "path": "/",
        "kind": "iframe",
        "source": "dist/index.html"
      }
    ],
    "csp": {
      "script-src": [
        "'self'",
        "'unsafe-inline'",
        "https://esm.sh"
      ],
      "style-src": [
        "'self'",
        "'unsafe-inline'",
        "https://esm.sh"
      ],
      "font-src": [
        "'self'",
        "https://esm.sh",
        "data:"
      ],
      "connect-src": [
        "'self'",
        "https://esm.sh"
      ]
    }
  },
  "capabilities": {
    "sqlite": {
      "db": "ikenga.local"
    }
  },
  "permissions": {
    "shell.execute": [],
    "fs.read": [],
    "fs.write": [],
    "net": [
      "https://esm.sh"
    ],
    "sqlite.tables": [
      "transaction_ledger",
      "receivables",
      "inter_company_entries",
      "bank_accounts",
      "latest_account_balances",
      "exchange_rates",
      "cfo_processing_runs",
      "finance_alerts",
      "paystack_splits"
    ],
    "vault.keys": []
  },
  "requires": [
    {
      "kind": "skill",
      "name": "skill-finance"
    }
  ]
}
